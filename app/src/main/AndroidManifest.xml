<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 11+ package visibility: without this, PackageManager hides
         Minecraft and detection falsely reports NOT INSTALLED.
         No Levi entry: the launcher never queries another launcher. -->
    <queries>
        <package android:name="com.mojang.minecraftpe" />
    </queries>

    <!-- Stage 20 (Phase 1, explicit user-driven observation only): loopback
         WebSocket observation needs INTERNET even for 127.0.0.1 (Android
         gates all app sockets on it). Relay: user-configured upstream
         forwarding only (RelayService) — endpoints chosen on the Relay
         screen, never auto-started, no other remote networking. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Foreground-service declarations for the explicit observation owner.
         Type specialUse: persistent localhost observation relay fits no
         other FGS type (Stage 19). Started only from the Activity. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Screenshot capture: MediaProjection sessions must run inside a
         mediaProjection typed foreground service when targeting Android 14+.
         No storage permission: saves go through scoped-storage MediaStore
         (API 29+) or the app's own folder (API 28). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <!-- HUD overlay: a TYPE_APPLICATION_OVERLAY window that paints the rendered
         HUD lines above the game. The permission is special (Settings, Apps,
         Special app access, Display over other apps) and is only ever requested
         by sending the user there, never silently assumed. Declared so the
         system can grant it; nothing starts without canDrawOverlays. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:label="Xykell Client"
        android:icon="@android:drawable/sym_def_app_icon"
        android:theme="@style/Theme.Xykell"
        android:allowBackup="true"
        android:supportsRtl="true">
        <!-- AppCompat in-app locales (misc.localization): persists the
             user-picked language on API <= 32 through the metadata holder;
             on API 33+ the OS stores it. Declared here, never exported. -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Explicit observation owner (Stage 20): started/stopped only by
             the Activity; never exported; never auto-started (no receiver,
             no boot path). Type specialUse per Stage-19 resolution. -->
        <service
            android:name=".runtime.observation.ObservationService"
            android:foregroundServiceType="specialUse"
            android:exported="false" />
        <!-- One-shot screenshot owner: started only after the user approves
             the system screen-capture dialog; never exported; never
             auto-started. Type mediaProjection is required on Android 14+. -->
        <service
            android:name=".runtime.capture.CaptureService"
            android:foregroundServiceType="mediaProjection"
            android:exported="false" />
        <!-- Transparent RakNet relay owner: started/stopped only from the
             Relay screen with explicit upstream settings; never exported;
             never auto-started. Plain UDP forwarding (specialUse — no other
             FGS type fits a user-driven packet relay). -->
        <service
            android:name=".runtime.relay.RelayService"
            android:foregroundServiceType="specialUse"
            android:exported="false" />
        <!-- HUD overlay window above the game. Started/stopped only from the
             HUD screen, and only once Settings.canDrawOverlays is true; never
             exported, never auto-started, and not a foreground service (it
             draws, it does not own the user's session). -->
        <service
            android:name=".ui.HudOverlayService"
            android:exported="false" />
        <!-- Serves the captured PNG to the share sheet only (cache path,
             read grant handed out per Intent). No broad file access. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!-- Real input cheat: gesture dispatch only (canPerformGestures in
             @xml/accessibility_service_config; canRetrieveWindowContent=false).
             The user enables it in system accessibility settings — never
             auto-started. BIND_ACCESSIBILITY_SERVICE blocks every caller
             except the system. -->
        <service
            android:name=".runtime.cheat.TouchAutomationService"
            android:label="Xykell Touch"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>

</manifest>

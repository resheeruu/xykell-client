<?xml version="1.0" encoding="utf-8"?>
<!--
  Dark slate backdrop. Deliberately not flat: a subtle top-left to bottom-right
  lift keeps the mark from looking like a sticker on a solid square, and it stays
  dark enough that the teal keeps its contrast under every launcher mask
  (circle, squircle, rounded square) and in both light and dark launchers.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0 h108 v108 h-108 z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0" android:startY="0"
                android:endX="108" android:endY="108"
                android:startColor="#161C26"
                android:endColor="#0C1017" />
        </aapt:attr>
    </path>
</vector>

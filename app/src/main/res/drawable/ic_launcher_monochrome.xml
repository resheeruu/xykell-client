<?xml version="1.0" encoding="utf-8"?>
<!--
  Monochrome layer for themed icons. Single flat shape, no colour. Android
  tints it with the user's palette. Keeping the diamond out is deliberate -
  themed icons are drawn small and a second shape would turn to mush.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:pathData="M34,34 L74,74"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="13"
        android:strokeLineCap="round" />
    <path
        android:pathData="M74,34 L34,74"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="13"
        android:strokeLineCap="round" />
</vector>

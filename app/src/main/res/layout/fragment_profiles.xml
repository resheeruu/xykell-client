<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/profiles_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/xykell_accent"
        android:layout_marginTop="16dp"
        android:text="@string/profiles_title"
        android:contentDescription="@string/profiles_title" />

    <TextView
        android:id="@+id/profiles_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="@color/xykell_muted"
        android:layout_marginTop="8dp" />

    <LinearLayout
        android:id="@+id/profiles_rows"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">

        <EditText
            android:id="@+id/profiles_new_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/profiles_name_hint"
            android:inputType="text"
            android:importantForAutofill="no"
            android:maxLines="1"
            android:minHeight="48dp" />

        <Button
            android:id="@+id/profiles_create"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/profiles_create" />
    </LinearLayout>

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/profiles_delete"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:text="@string/profiles_delete" />

        <Button
            android:id="@+id/profiles_reset"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:text="@string/profiles_reset" />
    </LinearLayout>

    <Button
        android:id="@+id/profiles_export"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:minHeight="56dp"
        android:text="@string/profiles_export" />

    <Button
        android:id="@+id/profiles_import"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:minHeight="56dp"
        android:text="@string/profiles_import" />

    <TextView
        android:id="@+id/profiles_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="@color/xykell_muted"
        android:layout_marginTop="8dp" />

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="24sp"
        android:textStyle="bold"
        android:text="@string/ui_hud_editor" />

    <!-- Overlay control: the HUD only paints over the game once the user grants
         "display over other apps" and turns it on here. -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/hud_overlay_status"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:gravity="center_vertical"
            android:text="@string/hud_overlay_stopped" />

        <Button
            android:minHeight="48dp"
            android:id="@+id/hud_overlay_grant"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hud_overlay_grant" />

        <Button
            android:minHeight="48dp"
            android:id="@+id/hud_overlay_toggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hud_overlay_start" />
    </LinearLayout>

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <EditText
            android:id="@+id/hud_profile"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:hint="@string/ui_profile_name"
            android:text="@string/ui_default" />

        <Button
        android:minHeight="48dp"
            android:id="@+id/hud_load"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ui_load" />

        <Button
        android:minHeight="48dp"
            android:id="@+id/hud_reset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ui_reset" />
    </LinearLayout>

    <TextView
        android:id="@+id/hud_preview_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:text="@string/ui_preview_structural" />

    <TextView
        android:id="@+id/hud_preview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:text="@string/ui_modules" />

    <LinearLayout
        android:id="@+id/hud_modules"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:text="@string/ui_elements_touch_drag_with_snap_available_in_game" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/hud_elements"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </ScrollView>

    <TextView
        android:id="@+id/hud_error"
        style="@style/XykellStatus" />

</LinearLayout>

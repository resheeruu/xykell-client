<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/friends_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/xykell_accent" />

    <TextView
        android:id="@+id/friends_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textSize="14sp"
        android:textColor="@color/xykell_muted" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:background="@color/xykell_surface"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/friends_section_add"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.15"
            android:textColor="@color/xykell_muted" />

        <EditText
            android:id="@+id/friends_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/friends_name_hint"
            android:inputType="text"
            android:importantForAutofill="no"
            android:maxLines="1"
            android:minHeight="48dp" />

        <EditText
            android:id="@+id/friends_color"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/friends_color_hint"
            android:inputType="text"
            android:importantForAutofill="no"
            android:maxLines="1"
            android:minHeight="48dp" />

        <EditText
            android:id="@+id/friends_notes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/friends_notes_hint"
            android:inputType="text"
            android:importantForAutofill="no"
            android:maxLines="2"
            android:minHeight="48dp" />

        <Button
            android:id="@+id/friends_add"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/friends_add" />

        <TextView
            android:id="@+id/friends_feedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="13sp"
            android:textColor="@color/xykell_muted" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:background="@color/xykell_surface"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/friends_section_list"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.15"
            android:textColor="@color/xykell_muted" />

        <TextView
            android:id="@+id/friends_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="13sp"
            android:textColor="@color/xykell_muted" />

        <LinearLayout
            android:id="@+id/friends_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical" />
    </LinearLayout>
</LinearLayout>

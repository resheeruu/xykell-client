<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Xykell" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/xykell_bg</item>
        <item name="android:textColor">@color/xykell_text</item>
        <item name="colorAccent">@color/xykell_accent</item>
    </style>

    <style name="XykellNavButton" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="XykellStatus" parent="android:Widget.TextView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/xykell_text</item>
        <item name="android:layout_marginTop">8dp</item>
    </style>
</resources>
